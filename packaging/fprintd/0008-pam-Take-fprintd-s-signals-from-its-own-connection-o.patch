     {
       pam_syslog (data->pamh, LOG_ERR, "Failed to parse VerifyFingerSelected signal: %d", errno);
@@ -366,6 +387,9 @@ verify_finger_matched (sd_bus_message *m,
   verify_data *data = userdata;
