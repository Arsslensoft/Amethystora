 PF_DEFINE_AUTOPTR_CLEANUP_FUNC (verify_data, verify_data_free)
 
+/* A signal of fprintd's only counts when the connection that owns its name
+ * sent it. A match on a well-known name is not enough: the bus delivers a
+ * message sent straight to this connection whatever its sender is. */
+static bool
+is_from_fprintd (verify_data    *data,
+                 sd_bus_message *m)
+{
+  const char *sender = sd_bus_message_get_sender (m);
+
+  return sender != NULL && data->owner != NULL && strcmp (sender, data->owner) == 0;
+}
+
 static int
 verify_result (sd_bus_message *m,
                void           *userdata,
@@ -271,6 +286,9 @@ verify_result (sd_bus_message *m,
   uint64_t done = false;
   int r;
 
+  if (!is_from_fprintd (data, m))
+    return 0;
+
