     return 0;
 
@@ -523,6 +547,32 @@ get_property_string (sd_bus       *bus,
 }
 
 
+/* The unique name of the connection that owns a well-known name */
+static char *
+get_name_owner (sd_bus     *bus,
+                const char *name)
+{
+  pf_auto (sd_bus_error) error = SD_BUS_ERROR_NULL;
+  pf_autoptr (sd_bus_message) reply = NULL;
+  const char *owner = NULL;
+
+  if (sd_bus_call_method (bus,
+                          "org.freedesktop.DBus",
+                          "/org/freedesktop/DBus",
+                          "org.freedesktop.DBus",
+                          "GetNameOwner",
+                          &error,
+                          &reply,
+                          "s",
+                          name) < 0)
+    return NULL;
+
+  if (sd_bus_message_read_basic (reply, 's', &owner) < 0 || owner == NULL || owner[0] != ':')
+    return NULL;
+
+  return strdup (owner);
+}
+
