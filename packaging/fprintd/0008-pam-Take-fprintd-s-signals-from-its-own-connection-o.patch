   if (sd_bus_message_read (m, "sss", &name, &old_owner, &new_owner) < 0)
     {
@@ -967,6 +1022,11 @@ do_auth (pam_handle_t *pamh, const char *username)
   if (data->dev == NULL)
     return PAM_AUTHINFO_UNAVAIL;
 
+  /* fprintd is running now: its signals are the ones this connection sends */
+  data->owner = get_name_owner (bus, "net.reactivated.Fprint");
+  if (data->owner == NULL)
+    return PAM_AUTHINFO_UNAVAIL;
+
   if (duress != DURESS_OFF)
     data->duress_finger = read_duress_finger (username, &data->uid);
 
diff --git a/tests/pam/test_pam_fprintd.py b/tests/pam/test_pam_fprintd.py
index 9b36f5c..bca9f0a 100644
--- a/tests/pam/test_pam_fprintd.py
+++ b/tests/pam/test_pam_fprintd.py
@@ -30,6 +30,62 @@ PAM_AUTHINFO_UNAVAIL = 9
 PAM_USER_UNKNOWN = 10
 PAM_MAXTRIES = 11
 
+# A program of another account on the same bus: it finds the connection the
+# module made once the verification has started (the only new one) and sends
+# it, straight to it, what only fprintd may say. Prints "ready" when it is
+# listening, and how many times it sent when it is done.
+FORGER = r'''
+import sys, time, dbus
+from dbus.lowlevel import SignalMessage
+
+device, seconds, kinds, finger, owner = sys.argv[1:6]
+bus = dbus.SystemBus(private=True)
+daemon = dbus.Interface(bus.get_object('org.freedesktop.DBus', '/org/freedesktop/DBus'), 'org.freedesktop.DBus')
+known = set(str(n) for n in daemon.ListNames())
+print('ready', flush=True)
+
+def send(target, path, iface, member, signature, *args):
+    m = SignalMessage(path, iface, member)
+    m.set_destination(target)
+    m.append(*args, signature=signature)
+    bus.send_message(m)
+
+sent = 0
+end = time.time() + float(seconds)
+while time.time() < end:
+    for name in set(str(n) for n in daemon.ListNames()) - known:
+        if not name.startswith(':') or name == bus.get_unique_name():
+            continue
+        for kind in kinds.split(','):
+            if kind == 'selected':
+                send(name, device, 'net.reactivated.Fprint.Device', 'VerifyFingerSelected', 's', 'any')
+            elif kind == 'matched':
+                send(name, device, 'net.reactivated.Fprint.Device', 'VerifyFingerMatched', 's', finger)
+            elif kind == 'status':
+                send(name, device, 'net.reactivated.Fprint.Device', 'VerifyStatus', 'sb', 'verify-match', True)
+            elif kind == 'owner':
+                send(name, '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'NameOwnerChanged', 'sss',
+                     'net.reactivated.Fprint', owner, '')
+        sent += 1
+    bus.flush()
+    time.sleep(0.05)
+print(sent, flush=True)
+'''
+
+def start_forger(device_path, kinds, finger='', seconds=3):
+    '''Start the forger, and return it once it is listening'''
+    owner = dbus.SystemBus(private=True).get_name_owner('net.reactivated.Fprint')
+    p = subprocess.Popen([sys.executable, '-c', FORGER, device_path, str(seconds), ','.join(kinds), finger, owner],
+                         stdout=subprocess.PIPE, universal_newlines=True)
+    assert p.stdout.readline().strip() == 'ready'
+    return p
+
+def forger_sent(p):
+    '''How many rounds the forger sent: none would make a test mean nothing'''
+    out = p.communicate(timeout=30)[0].strip()
+    assert p.returncode == 0
+    return int(out)
+
 class TestPamFprintd(dbusmock.DBusTestCase):
     '''Test pam_fprintd'''
 
@@ -350,6 +406,48 @@ class TestPamFprintd(dbusmock.DBusTestCase):
         self.assertEqual(len(res.errors), 0)
         self.assertEqual(len(res.info), 0)
 
+    def test_pam_fprintd_ignores_signals_of_others(self):
+        self.setup_device()
+        script = [
+            ( 'verify-no-match', True, 4000 ),
+            ( 'verify-match', True, 1000 ),
+        ]
+        self.device_mock.SetVerifyScript(script)
+
+        # A match that nobody but another connection said, while fprintd is
+        # still looking at the finger
+        forger = start_forger(self.device_mock.object_path, ['selected', 'matched', 'status'], 'left-little-finger')
+
+        tc = pypamtest.TestCase(pypamtest.PAMTEST_AUTHENTICATE, expected_rv=PAM_SUCCESS)
+        res = pypamtest.run_pamtest("toto", "fprintd-pam-test", [tc], [ 'unused' ])
+        self.assertGreater(forger_sent(forger), 0)
+
+        # Only fprintd's own no match and then its own match counted
+        self.assertEqual(len(res.errors), 1)
+        self.assertRegex(res.errors[0], r'Failed to match fingerprint')
+
+        # PAM left the device claimed once it had its match
+        self.device_mock.VerifyStop()
+        self.device_mock.Release()
+
+    def test_pam_fprintd_ignores_name_owner_changed_of_others(self):
+        self.setup_device()
+        script = [
+            ( 'verify-match', True, 4000 ),
+        ]
+        self.device_mock.SetVerifyScript(script)
+
+        # Not the bus, so not a reason to give up on fprintd
+        forger = start_forger(self.device_mock.object_path, ['owner'])
+
+        tc = pypamtest.TestCase(pypamtest.PAMTEST_AUTHENTICATE, expected_rv=PAM_SUCCESS)
+        res = pypamtest.run_pamtest("toto", "fprintd-pam-test", [tc], [ 'unused' ])
+        self.assertGreater(forger_sent(forger), 0)
+        self.assertEqual(len(res.errors), 0)
+
+        self.device_mock.VerifyStop()
+        self.device_mock.Release()
+
