+
+        for service in ['fprintd-pam-test-duress-allow', 'fprintd-pam-test-duress-deny']:
+            with self.subTest(service=service):
+                forger = start_forger(self.device_mock.object_path, ['selected', 'matched', 'status'], 'left-index-finger')
+                res = self.authenticate_after(service, PAM_SUCCESS, 4000)
+                self.assertGreater(forger_sent(forger), 0)
+                self.assertEqual(len(res.errors), 0)
