#!/usr/bin/bash
# A DisplayLink dock's screens stay dark with Mutter 51.0 and 51.1 where the graphics driver has no
# EGL_KHR_partial_update (radeonsi): the path Mutter 51 then draws through picks a screen's format without asking the
# dock's plane (create_bos_gbm), so it hands evdi 10-bit frames, evdi takes the framebuffer and refuses every frame
# made of it ("invalid pixel format AR30" with drm.debug, "drmModeAtomicCommit: Invalid argument" in the shell's
# journal). Mutter's issue 5100, fixed on its main branch by 9bc8cd84 (merge request 5372, to be backported to 51).
# Telling Mutter to copy the frames is the way around it until the image's Mutter has that fix: 20-tests.sh fails
# on Mutter 51.2 or newer, so that this file is taken out then. Found on a ThinkPad Hybrid USB-C dock (2026-11-27).
#
# Mutter reads the variable once, for every graphics device but the first, so it also costs a second graphics card
# its own copy. Hence: always on a machine with one graphics card, where it changes nothing else, so a dock plugged
# in later lights up; with several, only when a dock (USB vendor 17e9) is there as the session starts. It sorts
# before systemd's own generator, so an account's environment.d has the last word.
# AMETHYSTORA_DISPLAYLINK_ROOT is a stand-in /sys, for 20-tests.sh.

set -euo pipefail
shopt -s nullglob

ROOT="${AMETHYSTORA_DISPLAYLINK_ROOT:-}"
dock=0
cards=0
for file in "${ROOT}"/sys/bus/usb/devices/*/idVendor; do
    if [[ "$(<"${file}")" == 17e9 ]]; then dock=1; fi
done
for file in "${ROOT}"/sys/bus/pci/devices/*/class; do
    if [[ "$(<"${file}")" == 0x03* ]]; then cards=$((cards + 1)); fi
done
if ((dock || cards < 2)); then
    echo MUTTER_DEBUG_MULTI_GPU_FORCE_COPY_MODE=primary-gpu-cpu
fi
