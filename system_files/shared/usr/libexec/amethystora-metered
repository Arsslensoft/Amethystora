#!/usr/bin/bash
# Saving data on a connection that counts it (plans/ui-ideas/spec-restart.md 3). On a connection NetworkManager calls
# metered (yes, or guessed yes: a phone's hotspot, mobile broadband, a network marked so in Settings), the updates that
# start by themselves wait for one that does not: the system update with the apps and Homebrew (uupd.service), the
# containers' upgrade (amethystora-pkg-upgrade.service) and a backup to the network (amethystora-backup.service). Each
# unit asks this in its ExecCondition, so a skipped run is neither a failure nor a retry. Never longer than a week: the
# first run that waited is kept in a stamp, and once that is seven days old the run goes whatever the connection. A run
# that worked takes the stamp away (each unit's ExecStartPost).
#
#   metered        exits 0 when the connection counts data
#   wait WHAT      ExecCondition: 0 to run, 1 to wait. A run a person started (no $TRIGGER_UNIT: Update now, Back up
#                  now, ame update) always runs, as does a backup to a disk of this machine.
#   done WHAT      ExecStartPost: the stamp taken away
#   status --json  {"metered": true|false, "waiting": {"system": SECONDS|null, "containers": ..., "backup": ...}}
#   through on|off the pill's Get me through (modules/pill/through.js): on writes the caller's process number (GNOME Shell,
#                  which started this) into a mark in $XDG_RUNTIME_DIR. While that process is still gnome-shell and the
#                  machine is on battery, the account's timed backup and containers' upgrade wait as they do on a metered
#                  connection: the same stamp, so never longer than a week, and a backup to a disk of this machine never.
#                  The system update needs no mark: uupd's own hardware check keeps it waiting under 20%.
#   playing on|off [ended]
#                  the pill's While you play (modules/power/playing.js): on writes the caller's process number and the time into
#                  a mark in $XDG_RUNTIME_DIR, kept while a game is registered with GameMode. While that process is still
#                  gnome-shell and the mark is under six hours old, the account's timed backup and containers' upgrade wait
#                  (a backup to a disk of this machine too: it reads and writes the disk the game is on). Never the system
#                  update, which is root's and which no file of an account may delay, and never a run a person started. The
#                  six hours are counted from the mark's own time, so a game that never unregisters cannot hold them for good.
#                  off takes the mark away; off ended (the game ended, or Let them run) also starts what a timer found held,
#                  once, since a timer that was skipped would not try again until its next day, and only if the waits a timer has
#                  apart from a game (a connection that counts data, Get me through) would let it run now. A run those hold back
#                  keeps their stamp and is not remembered. A lock takes the mark away without it: the game may still be running.
#
# WHAT is system (as root: the stamp in /var/lib/amethystora/metered, readable by everyone, so that the pill and System
# Updates can say since when), containers or backup (as the account: in ~/.local/state/amethystora/metered).

set -euo pipefail

WEEK=$((7 * 24 * 3600))
SYSTEM_DIR=/var/lib/amethystora/metered
USER_DIR="${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/amethystora/metered"
BACKUP_ENV="${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/amethystora/backup.env"
THROUGH="${XDG_RUNTIME_DIR:-/nonexistent}/amethystora/get-through"
PLAYING="${XDG_RUNTIME_DIR:-/nonexistent}/amethystora/playing"
# What a timer found held by a game, to be started when the game ends (one empty file for each)
WAITED="${XDG_RUNTIME_DIR:-/nonexistent}/amethystora/playing-waited"
SIX_HOURS=$((6 * 3600))
# Filesystems that are another machine's disk
NETWORK_FS='^(nfs|nfs4|cifs|smb3|smbfs|9p|ceph|glusterfs|davfs|fuse\.(sshfs|rclone|s3fs|davfs2|gvfsd-fuse))$'

usage() {
    echo "usage: ${0##*/} metered | wait system|containers|backup|backup-other | done system|containers|backup|backup-other | status --json | through on|off | playing on|off [ended]" >&2
    exit 2
}

# NMMetered: 1 yes, 3 guessed yes (4 guessed no, 2 no, 0 unknown)
metered() {
    [[ "$(busctl --system get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager \
        org.freedesktop.NetworkManager Metered 2>/dev/null)" =~ ^u\ (1|3)$ ]]
}

# The pill's Get me through: only on battery, and only while the GNOME Shell that wrote the mark is still there (the mark
# holds its process number), so that a mark left behind by a shell that died never holds up a run
getting_through() {
    local pid
    [[ -r "${THROUGH}" ]] || return 1
    pid="$(head -c 16 -- "${THROUGH}" | tr -dc 0-9)"
    [[ -n "${pid}" && "$(cat -- "/proc/${pid}/comm" 2>/dev/null)" == gnome-shell ]] || return 1
    [[ "$(busctl --system get-property org.freedesktop.UPower /org/freedesktop/UPower \
        org.freedesktop.UPower OnBattery 2>/dev/null)" == "b true" ]]
}

# The pill's While you play: only while the shell that wrote the mark is still there, and for six hours at most from the mark's
# own time (a time in the future, from a clock that was set back, holds nothing)
playing() {
    local pid start now
    [[ -r "${PLAYING}" ]] || return 1
    read -r pid start < <(head -c 64 -- "${PLAYING}") || true
    [[ "${pid:-}" =~ ^[0-9]{1,10}$ && "${start:-}" =~ ^[0-9]{1,12}$ ]] || return 1
    [[ "$(cat -- "/proc/${pid}/comm" 2>/dev/null)" == gnome-shell ]] || return 1
    now="$(date +%s)"
    ((now >= start && now - start < SIX_HOURS))
}

unit_of() {
    case "$1" in
        backup) echo amethystora-backup.service ;;
        containers) echo amethystora-pkg-upgrade.service ;;
        backup-other) echo amethystora-backup-other.service ;;
    esac
}

stamp_of() {
    case "$1" in
        system) echo "${SYSTEM_DIR}/system" ;;
        containers | backup | backup-other) echo "${USER_DIR}/$1" ;;
        *) usage ;;
    esac
}

# Whether the backup goes to this machine's own disks: a path (or local:path) on a filesystem that is not a share
backup_is_local() {
    local repository path fstype
    [[ -r "${BACKUP_ENV}" ]] || return 1
    # Read, never run: the line as `ame backup` writes it, quotes and all
    repository="$(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?RESTIC_REPOSITORY=//p' "${BACKUP_ENV}" | tail -n1)"
    repository="${repository%\"}"
    repository="${repository#\"}"
    repository="${repository%\'}"
    repository="${repository#\'}"
    path="${repository#local:}"
    [[ "${path}" == /* ]] || return 1
    while [[ ! -e "${path}" && "${path}" != / ]]; do path="$(dirname -- "${path}")"; done
    fstype="$(findmnt -n -o FSTYPE --target "${path}" 2>/dev/null | head -n1)"
    [[ -n "${fstype}" && ! "${fstype}" =~ ${NETWORK_FS} ]]
}

# The waits a timer's run has apart from a game (a connection that counts data, Get me through, each with its stamp and its
# week): 0 to run, 1 to wait. Without a game this is all of do_wait, and a game's end asks it again before it starts anything.
wait_other() {
    local what="$1" stamp first now why
    stamp="$(stamp_of "${what}")"
    if [[ "${what}" == backup ]] && backup_is_local; then
        return 0
    fi
    # Why it waits: the connection counts data, or the pill's Get me through is on (the account's own runs only). Either
    # way the first wait is kept in the stamp, and a week later it goes.
    if metered; then
        why=metered
    elif [[ "${what}" != system ]] && getting_through; then
        why=through
    else
        rm -f -- "${stamp}"
        return 0
    fi
    now="$(date +%s)"
    if [[ -s "${stamp}" ]]; then
        first="$(head -c 32 -- "${stamp}" | tr -dc 0-9)"
        if [[ -n "${first}" && $((now - first)) -ge ${WEEK} ]]; then
            echo "This has waited a week: it runs now."
            return 0
        fi
    else
        mkdir -p -m 0755 -- "$(dirname -- "${stamp}")"
        printf '%s\n' "${now}" >"${stamp}"
        chmod 0644 -- "${stamp}"
    fi
    if [[ "${why}" == metered ]]; then
        echo "This connection counts data: waiting for one that does not (at most a week). It runs at once when started by hand."
    else
        echo "Getting through on the battery: waiting until the machine is plugged in (at most a week). It runs at once when started by hand."
    fi
    return 1
}

do_wait() {
    local what="$1"
    # Started by a person, not by its timer
    [[ -n "${TRIGGER_UNIT:-}" ]] || return 0
    # A game is playing: the account's own runs wait, a backup to this machine's disk too, and a run that is only held by
    # the game is remembered so that the end of the game starts it. No stamp: the six hours are the mark's. A run that
    # would wait for a connection that counts data or for Get me through anyway keeps those words and that stamp, and is
    # not remembered: the game's end must not start what they hold back.
    if [[ "${what}" != system ]] && playing; then
        wait_other "${what}" || return 1
        mkdir -p -m 0700 -- "${WAITED}"
        : >"${WAITED}/${what}"
        echo "A game is playing: waiting until it ends (at most six hours). It runs at once when started by hand."
        return 1
    fi
    wait_other "${what}"
}

stamp_json() {
    local stamp first
    stamp="$(stamp_of "$1")"
    first="$(head -c 32 -- "${stamp}" 2>/dev/null | tr -dc 0-9)" || true
    if [[ -n "${first}" ]]; then echo "${first}"; else echo null; fi
}

[[ $# -ge 1 ]] || usage
case "$1" in
    metered)
        [[ $# -eq 1 ]] || usage
        metered
        ;;
    wait)
        [[ $# -eq 2 ]] || usage
        do_wait "$2"
        ;;
    done)
        [[ $# -eq 2 ]] || usage
        rm -f -- "$(stamp_of "$2")" "${WAITED}/$2" "${WAITED}/started-$2"
        rmdir -- "${WAITED}" 2>/dev/null || true
        ;;
    status)
        [[ $# -eq 2 && "$2" == --json ]] || usage
        if metered; then on=true; else on=false; fi
        printf '{"metered":%s,"waiting":{"system":%s,"containers":%s,"backup":%s}}\n' "${on}" \
            "$(stamp_json system)" "$(stamp_json containers)" "$(stamp_json backup)"
        ;;
    through)
        [[ $# -eq 2 ]] || usage
        case "$2" in
            on)
                mkdir -p -m 0700 -- "$(dirname -- "${THROUGH}")"
                printf '%s\n' "${PPID}" >"${THROUGH}"
                ;;
            off) rm -f -- "${THROUGH}" ;;
            *) usage ;;
        esac
        ;;
    playing)
        [[ $# -ge 2 ]] || usage
        case "$2" in
            on)
                [[ $# -eq 2 ]] || usage
                mkdir -p -m 0700 -- "$(dirname -- "${PLAYING}")"
                # The same shell asking again keeps the time it began
                if ! { playing && [[ "$(head -c 16 -- "${PLAYING}" | cut -d' ' -f1)" == "${PPID}" ]]; }; then
                    printf '%s %s\n' "${PPID}" "$(date +%s)" >"${PLAYING}.new"
                    mv -f -- "${PLAYING}.new" "${PLAYING}"
                fi
                ;;
            off)
                [[ $# -le 3 && ( $# -eq 2 || "$3" == ended ) ]] || usage
                rm -f -- "${PLAYING}"
                if [[ $# -eq 3 && -d "${WAITED}" ]]; then
                    for what in backup containers backup-other; do
                        if [[ -e "${WAITED}/${what}" ]]; then
                            rm -f -- "${WAITED}/${what}"
                            # Only what the timer's own waits would let run now: a connection that counts data and Get me
                            # through still hold it back, with their stamps and their week
                            wait_other "${what}" >/dev/null 2>&1 || continue
                            # A unit started by hand has no TRIGGER_UNIT, so the containers' own checks (a battery that is
                            # low, a busy machine, no network) would be skipped: this tells amethystora-pkg to make them
                            [[ "${what}" != containers ]] || : >"${WAITED}/started-containers"
                            systemctl --user start --no-block "$(unit_of "${what}")" >/dev/null 2>&1 || true
                        fi
                    done
                    rmdir -- "${WAITED}" 2>/dev/null || true
                fi
                ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
