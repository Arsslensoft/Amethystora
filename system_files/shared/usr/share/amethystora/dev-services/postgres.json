{
    "name": "postgres",
    "title": "PostgreSQL 18",
    "aliases": ["postgresql"],
    "image": "docker.io/library/postgres@sha256:b6972e1115a4ff8eba5d7f7d19184926d1e16d7d1136ae1e1a7ebf286da0f015",
    "tag": "18-alpine",
    "size_mb": 120,
    "ports": [{"port": 5432}],
    "volume": "/var/lib/postgresql",
    "env": {"POSTGRES_USER": "dev", "POSTGRES_DB": "dev", "POSTGRES_PASSWORD": "${PASSWORD}"},
    "connect": "postgresql://dev@127.0.0.1:${PORT}/dev"
}
